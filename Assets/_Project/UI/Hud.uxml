<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Hud.uss" />
    <ui:VisualElement name="root" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="stats" class="hud__stats" picking-mode="Ignore">
            <ui:Label name="healthLabel" class="hud__stat" text="HP: 5/5" />
            <ui:Label name="waveLabel" class="hud__stat" text="Fala: 0" />
            <ui:Label name="enemiesLabel" class="hud__stat" text="Wrogowie: 0" />
            <ui:Label name="scoreLabel" class="hud__stat" text="Punkty: 0" />
            <ui:Label name="killsLabel" class="hud__stat" text="Zabici: 0" />
            <ui:Label name="timeLabel" class="hud__stat" text="Czas: 0 s" />
            <ui:Label name="recordLabel" class="hud__stat" text="Rekord: 0" />
        </ui:VisualElement>
        <ui:VisualElement name="banner" class="banner banner--hidden" picking-mode="Ignore">
            <ui:Label name="bannerTitle" class="banner__title" text="FALA 1" />
            <ui:Label name="bannerSubtitle" class="banner__subtitle" text="Fala 1 za 3…" />
        </ui:VisualElement>
        <ui:VisualElement name="gameOverPanel" class="game-over game-over--hidden" picking-mode="Ignore">
            <ui:Label class="game-over__title" text="GAME OVER" />
            <ui:Label name="scoreResultLabel" class="game-over__score" text="Punkty: 0" />
            <ui:Label name="summaryLabel" class="game-over__line" text="Fala: 0   Zabici: 0   Czas: 0 s" />
            <ui:Label name="recordResultLabel" class="game-over__line" text="Rekord: 0" />
            <ui:Label class="game-over__hint" text="R — restart" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
